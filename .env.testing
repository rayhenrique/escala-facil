# Ambiente exclusivo para testes automatizados (php artisan test / CI).
# Não contém credenciais reais. A chave abaixo é fictícia e serve apenas
# para a suíte de testes; nunca a utilize em produção.
APP_NAME="Escala Fácil"
APP_ENV=testing
APP_KEY=base64:4lY6gqg3qFU1X7rgVu2SrP8C8SdqoslDqslNZeldznE=
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Maceio

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Observabilidade desativada nos testes: nenhum erro sai da máquina local.
SENTRY_DSN=

# Banco padrão da suíte: SQLite em memória (ver phpunit.xml).
# O job MySQL do CI sobrescreve estas variáveis via ambiente, sem expor segredos.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=
DB_ENGINE=InnoDB

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="nao-responda@escalafacil.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
